{
  "name": "chamberbalet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Камерный театр балета — одностраничная презентация для площадок",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "BUILD_MODE=debug node scripts/build.mjs",
    "images": "node scripts/build-images.mjs",
    "video": "node scripts/build-video.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-flight.mjs && node scripts/check-scrim.mjs && node scripts/check-contrast-photos.mjs && node scripts/check-topbar-strip.mjs && node scripts/check-transfer.mjs",
    "check:transfer": "node scripts/check-transfer.mjs",
    "check:topbar": "node scripts/check-topbar-strip.mjs",
    "check:contrast": "node scripts/check-contrast-photos.mjs",
    "pace": "node scripts/measure-pace.mjs",
    "demo": "node scripts/build-demo.mjs",
    "qa": "node scripts/qa/browser.mjs",
    "qa:demo": "node scripts/qa/demo.mjs",
    "qa:lazy": "node scripts/qa/lazy.mjs",
    "lcp": "node scripts/qa/lcp.mjs",
    "lighthouse": "node scripts/qa/lighthouse.mjs",
    "qa:accept": "node scripts/qa/accept.mjs",
    "qa:rest": "node scripts/qa/rest.mjs",
    "qa:contrast": "node scripts/qa/contrast-live.mjs",
    "qa:fit": "node scripts/qa/fit-frame.mjs",
    "qa:seam": "node scripts/qa/seam.mjs",
    "qa:chapter": "node scripts/qa/chapter-top.mjs",
    "qa:wordmark": "node scripts/qa/wordmark-widths.mjs"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.4.0"
  }
}
